{% extends 'pages/base.html.twig' %}

{% block title %}Mon profile{% endblock %}

{% block body %}
    {% include 'component/nav.html.twig' %}

    <h1 class="text-center text-4xl font-extrabold">Créer un Formulaire</h1>

    <div class="max-w-lg mx-auto bg-gray-800 p-8 mt-4 mb-3 rounded-lg">
        <h2 class="text-white text-lg font-semibold mb-4 text-center">Créer un formulaire</h2>
        {{ form_start(form) }}

        <div class="mt-4">
            {{ form_label(form.title, 'Sujet', { 'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'} }) }}
            {{ form_widget(form.title, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 ', placeholder:"Votre sujet"} }) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mt-4">
            {{ form_label(form.content, 'Votre Message', { 'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'} }) }}
            {{ form_widget(form.content, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 ', placeholder:"Votre message"} }) }}
            {{ form_errors(form.content) }}
        </div>

        <div class="mt-4">
            {{ form_label(form.date, 'Date', { 'label_attr': {'class': 'block mb-2 text-sm font-medium text-gray-900 dark:text-white'} }) }}
            {{ form_widget(form.date, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 '}}) }}
            {{ form_errors(form.date) }}
        </div>

        <div class="mt-4">
            <button type="submit" class=" text-white font-semibold border-solid border-black bg-black px-3 py-3 rounded-lg">Enregistrer</button>
        </div>

        {{ form_end(form) }}
    </div>

    

{% endblock %}