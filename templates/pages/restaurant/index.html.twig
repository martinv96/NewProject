{% extends 'pages/base.html.twig' %}

{% block title %}Mon profile{% endblock %}

{% block body %}
    {% include 'component/nav.html.twig' %}

    <h1 class=' text-indigo-700 text-5xl font-bold text-center'>Restaurant</h1>

    <form action="">
        <input type="text" name="name" placeholder="Nom du restaurant">
        <button type="submit">Enregistrer</button>
    </form>

    <section>
    {% for restaurant in restaurants %}
        <p>{{ restaurant.name }}</p>
    {% endfor %}
    </section>

{% endblock %}